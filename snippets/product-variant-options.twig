{# SPD-2051 - single-product options & variants selector.
   Renders product.optionSet: every option's values as buttons. Colour options (detected
   with sitepack_is_color_filter) render as the same coloured dots as the category
   filters via sitepack_color_swatch; other options render as text buttons.

   The styling lives in assets/css/theme.css (.sp-variant-* rules) and the behaviour in
   assets/js/theme.js (picking a value resolves the matching variant, switches the main
   image, drives the price/availability and the add-to-cart form). Include it wherever a
   product with options should show its picker:
     {% if product.optionSet and product.optionSet.options|length > 0 %}
         {% include 'snippets/product-variant-options.twig' %}
     {% endif %}
#}
<div class="sp-variant-options"
     data-options='{{ product.optionSet.options|json_encode|raw }}'
     data-variants='{{ product.optionSet.variants|json_encode|raw }}'
     data-unavailable-label="{{ 'product.out_of_stock'|trans }}">

    {% for option in product.optionSet.options %}
        {% set is_color = sitepack_is_color_filter(option.name) %}
        <div class="sp-variant-option" data-option-name="{{ option.name }}">
            <span class="sp-variant-option__label">
                <strong>{{ option.name }}</strong>
                <span class="sp-variant-selected" data-option-selected="{{ option.name }}"></span>
            </span>
            <div class="sp-variant-option__values{% if is_color %} sp-variant-option__values--swatches{% endif %}">
                {% for value in option.values %}
                    {% set sw = is_color ? sitepack_color_swatch(value) : null %}
                    {% if is_color and sw.known %}
                        <button type="button"
                                class="sp-variant-value sp-variant-value--swatch{% if sw.multi %} is-multi{% endif %}"
                                data-option="{{ option.name }}" data-value="{{ value }}"
                                title="{{ value }}" aria-label="{{ value }}">
                            <span class="color-swatch" style="background: {{ sw.background }}"></span>
                        </button>
                    {% else %}
                        <button type="button" class="sp-variant-value"
                                data-option="{{ option.name }}" data-value="{{ value }}"
                                title="{{ option.name }}: {{ value }}">{{ value }}</button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <div class="sp-variant-availability" data-variant-availability hidden></div>
</div>
