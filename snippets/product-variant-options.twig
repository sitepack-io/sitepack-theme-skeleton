{# SPD-2051 - single-product options & variants selector.
   Renders product.optionSet: every option's values as buttons. Colour options (detected
   with sitepack_is_color_filter) render as the same coloured dots as the category
   filters via sitepack_color_swatch; other options render as text buttons. Picking a
   full set of values resolves the matching variant and, without navigating away,
   switches the main image, updates price and availability, writes the variant uuid into
   the add-to-cart form and toggles its submit button. Self-contained: no theme CSS or
   SDK dependency. Include it wherever a product with options should show its picker:
     {% if product.optionSet and product.optionSet.options|length > 0 %}
         {% include 'snippets/product-variant-options.twig' %}
     {% endif %}
#}
<div class="sp-variant-options"
     data-options='{{ product.optionSet.options|json_encode|raw }}'
     data-variants='{{ product.optionSet.variants|json_encode|raw }}'>

    {% for option in product.optionSet.options %}
        {% set is_color = sitepack_is_color_filter(option.name) %}
        <div class="sp-variant-option" data-option-name="{{ option.name }}">
            <span class="sp-variant-option__label">
                <strong>{{ option.name }}</strong>
                <span class="sp-variant-selected" data-option-selected="{{ option.name }}"></span>
            </span>
            <div class="sp-variant-option__values{% if is_color %} sp-variant-option__values--swatches{% endif %}">
                {% for value in option.values %}
                    {% set sw = is_color ? sitepack_color_swatch(value) : null %}
                    {% if is_color and sw.known %}
                        <button type="button"
                                class="sp-variant-value sp-variant-value--swatch{% if sw.multi %} is-multi{% endif %}"
                                data-option="{{ option.name }}" data-value="{{ value }}"
                                title="{{ value }}" aria-label="{{ value }}">
                            <span class="color-swatch" style="background: {{ sw.background }}"></span>
                        </button>
                    {% else %}
                        <button type="button" class="sp-variant-value"
                                data-option="{{ option.name }}" data-value="{{ value }}"
                                title="{{ option.name }}: {{ value }}">{{ value }}</button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <div class="sp-variant-summary">
        <span class="sp-variant-price" data-variant-price></span>
        <span class="sp-variant-availability" data-variant-availability></span>
    </div>
</div>

<style>
    .sp-variant-options { margin: 0 0 1rem; }
    .sp-variant-option { margin-bottom: 1.1rem; }
    .sp-variant-option__label { display: block; margin-bottom: .5rem; }
    .sp-variant-option__label strong { font-weight: 700; }
    .sp-variant-selected { color: inherit; opacity: .75; }
    .sp-variant-option__values { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .sp-variant-option__values--swatches { gap: 10px; }

    /* Text option values */
    .sp-variant-value {
        padding: .45rem .85rem;
        border: 1px solid currentColor;
        border-radius: 4px;
        background: transparent;
        color: inherit;
        cursor: pointer;
        line-height: 1.2;
        opacity: .7;
        transition: opacity .12s, border-width .12s;
    }
    .sp-variant-value:hover { opacity: 1; }
    .sp-variant-value.is-active { opacity: 1; border-width: 2px; font-weight: 700; }
    .sp-variant-value.is-unavailable {
        opacity: .35;
        text-decoration: line-through;
        cursor: not-allowed;
    }

    /* Colour option values: the same round dots as the category filters. */
    .sp-variant-value--swatch {
        padding: 2px;
        border: 0;
        border-radius: 50%;
        background: transparent;
        opacity: 1;
        line-height: 0;
    }
    .sp-variant-value--swatch .color-swatch {
        position: relative;
        display: block;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
        transition: transform .12s ease, box-shadow .12s ease;
        background-size: cover;
        background-position: center;
    }
    .sp-variant-value--swatch:hover .color-swatch {
        transform: scale(1.12);
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    }
    .sp-variant-value--swatch.is-active .color-swatch {
        box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--main-color, #333333);
    }
    .sp-variant-value--swatch.is-active .color-swatch::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 5px;
        height: 9px;
        margin: -6px 0 0 -3px;
        border: solid #ffffff;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
        filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.65));
    }
    .sp-variant-value--swatch.is-unavailable {
        opacity: .35;
        cursor: not-allowed;
    }

    .sp-variant-summary { margin: .35rem 0 1rem; }
    .sp-variant-price { font-weight: 700; margin-right: .75rem; }
    .sp-variant-availability.is-unavailable { color: #b00020; font-weight: 600; }
</style>

<script>
    (function () {
        function escapeAttr(value) {
            return (window.CSS && CSS.escape) ? CSS.escape(value) : value;
        }

        function init(root) {
            if (root.dataset.spInit) {
                return;
            }
            root.dataset.spInit = '1';

            var options = JSON.parse(root.getAttribute('data-options') || '[]');
            var variants = JSON.parse(root.getAttribute('data-variants') || '[]');
            var selected = {};

            var form = root.closest('form') || document.querySelector('form.product-add-to-cart');
            var priceEl = root.querySelector('[data-variant-price]');
            var availabilityEl = root.querySelector('[data-variant-availability]');
            var unavailableLabel = {{ 'product.out_of_stock'|trans|json_encode|raw }};

            function hiddenField() {
                if (!form) {
                    return null;
                }
                var field = form.querySelector('input[name="variantUuid"], input[name$="[variantUuid]"]');
                if (!field) {
                    field = document.createElement('input');
                    field.type = 'hidden';
                    field.name = 'variantUuid';
                    form.appendChild(field);
                }
                return field;
            }

            function submitButton() {
                return form ? form.querySelector('button[type="submit"], input[type="submit"]') : null;
            }

            function findVariant() {
                var names = options.map(function (option) { return option.name; });
                if (names.some(function (name) { return !selected[name]; })) {
                    return null;
                }
                return variants.find(function (variant) {
                    return names.every(function (name) {
                        return variant.optionValues && variant.optionValues[name] === selected[name];
                    });
                }) || null;
            }

            function applyVariant(variant) {
                var field = hiddenField();
                var submit = submitButton();

                if (!variant) {
                    if (field) { field.value = ''; }
                    if (priceEl) { priceEl.textContent = ''; }
                    if (availabilityEl) {
                        availabilityEl.textContent = '';
                        availabilityEl.classList.remove('is-unavailable');
                    }
                    if (submit) { submit.disabled = true; }
                    return;
                }

                if (field) { field.value = variant.uuid; }

                if (variant.image && variant.image.url && typeof window.viewProductImage === 'function') {
                    window.viewProductImage(variant.image.url);
                }

                if (priceEl) {
                    priceEl.textContent = variant.pricePretty ? ('€ ' + variant.pricePretty) : '';
                }

                if (availabilityEl) {
                    availabilityEl.textContent = variant.available ? '' : unavailableLabel;
                    availabilityEl.classList.toggle('is-unavailable', !variant.available);
                }

                if (submit) { submit.disabled = !variant.available; }
            }

            function refreshDisabledStates() {
                root.querySelectorAll('.sp-variant-value').forEach(function (button) {
                    var trial = Object.assign({}, selected);
                    trial[button.getAttribute('data-option')] = button.getAttribute('data-value');

                    var possible = variants.some(function (variant) {
                        return Object.keys(trial).every(function (name) {
                            return variant.optionValues && variant.optionValues[name] === trial[name];
                        });
                    });
                    button.classList.toggle('is-unavailable', !possible);
                });
            }

            function select(optionName, value) {
                selected[optionName] = value;

                root.querySelectorAll('.sp-variant-value[data-option="' + escapeAttr(optionName) + '"]').forEach(function (button) {
                    button.classList.toggle('is-active', button.getAttribute('data-value') === value);
                });

                var label = root.querySelector('[data-option-selected="' + escapeAttr(optionName) + '"]');
                if (label) {
                    label.textContent = value;
                }

                refreshDisabledStates();
                applyVariant(findVariant());
            }

            root.querySelectorAll('.sp-variant-value').forEach(function (button) {
                button.addEventListener('click', function () {
                    select(button.getAttribute('data-option'), button.getAttribute('data-value'));
                });
            });

            // Land on the first available variant (or the first one) so the shopper starts
            // from a valid selection with its image and price already shown.
            var initial = variants.find(function (variant) { return variant.available; }) || variants[0];
            if (initial && initial.optionValues) {
                Object.keys(initial.optionValues).forEach(function (name) {
                    select(name, initial.optionValues[name]);
                });
            } else {
                refreshDisabledStates();
            }
        }

        function boot() {
            document.querySelectorAll('.sp-variant-options').forEach(init);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
    })();
</script>
