{% extends 'layouts/base.twig' %}

{#
    Category listing. Data supplied by the platform:
      category            the category (name, slug, elementsAbove/Below)
      products            the products on this page
      filters             the filter groups (attributes, category tree, price)
      activated_filters   map of filter key -> [active option slugs]
      quick_filters       sub-category quick links
      sort_direction      popularity | priceasc | pricedesc
      total_products, total_pages, current_page

    Filter and page links are plain routes handled by the platform:
      /categories/{slug}/{page}
      /categories/{slug}/filter/{key}/{value}
      /categories/{slug}/remove/{key}/{value}
      /categories/{slug}/clear
#}

{% block content %}
    {% app_block 'category_before' %}

    <h1 class="container-element">{{ category.name }}</h1>

    {# Content-editor elements above the listing. Rendered as direct children of <main>,
       exactly like page.twig does, so they get the same gutter as everything else. #}
    {% if category.elementsAbove is defined and category.elementsAbove %}
        {{ sitepack_elements(category.elementsAbove) }}
    {% endif %}

    {% if quick_filters is defined and quick_filters|length > 0 %}
        <div class="container-element category-quick-filters">
            {% for quick in quick_filters %}
                <a href="{{ quick.url|ensure_link }}" class="btn btn-default">{{ quick.name }}</a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="container-element category-main-layout">
        {% if filters is defined and filters|length > 0 %}
            <aside class="category-sidebar">
                <h3 class="category-filters-title">{{ 'category.filters_title'|trans }}</h3>
                <button class="btn btn-primary btn-block" id="sidebar-filter-toggle" type="button">
                    {{ 'category.show_filters'|trans }}
                </button>

                <div id="sidebar-category-filters">
                    {{ sitepack_category_filters() }}
                </div>
            </aside>
        {% endif %}

        <div class="category-products-content">
            <div class="category-toolbar">
                <div class="category-toolbar__meta">
                    <span class="category-toolbar__count">
                        {{ 'category.products_count'|trans({'%count%': total_products|default(products|length)}) }}
                    </span>
                    {% if activated_filters is defined and activated_filters|length > 0 %}
                        <a class="category-toolbar__clear" href="/categories/{{ category.slug }}/clear">
                            {{ 'category.clear_filters'|trans }}
                        </a>
                    {% endif %}
                </div>

                <label class="category-sort">
                    <span>{{ 'category.sort'|trans }}</span>
                    <select id="category-sort" data-url="/categories/{{ category.slug }}">
                        <option value="popularity"{% if sort_direction|default('popularity') == 'popularity' %} selected{% endif %}>{{ 'category.sort_popularity'|trans }}</option>
                        <option value="priceasc"{% if sort_direction|default('') == 'priceasc' %} selected{% endif %}>{{ 'category.sort_price_asc'|trans }}</option>
                        <option value="pricedesc"{% if sort_direction|default('') == 'pricedesc' %} selected{% endif %}>{{ 'category.sort_price_desc'|trans }}</option>
                    </select>
                </label>
            </div>

            {% if products|length > 0 %}
                <div class="products-wrapper">
                    {% for product in products %}
                        {% app_block 'product_card_before' %}
                        {% include 'snippets/product-card.twig' with { product: product } %}
                        {% app_block 'product_card_after' %}
                    {% endfor %}
                </div>
            {% else %}
                <p>{{ 'general.no_products'|trans }}</p>
            {% endif %}

            {% if total_pages is defined and total_pages > 1 %}
                <nav class="category-pagination" aria-label="{{ 'category.pagination'|trans }}">
                    {% if current_page > 1 %}
                        <a class="btn btn-default" href="/categories/{{ category.slug }}/{{ current_page - 1 }}">{{ 'category.previous'|trans }}</a>
                    {% endif %}
                    {% for n in 1..total_pages %}
                        {% if n == current_page %}
                            <span class="btn btn-primary" aria-current="page">{{ n }}</span>
                        {% elseif n == 1 or n == total_pages or (n >= current_page - 2 and n <= current_page + 2) %}
                            <a class="btn btn-default" href="/categories/{{ category.slug }}/{{ n }}">{{ n }}</a>
                        {% elseif n == current_page - 3 or n == current_page + 3 %}
                            <span class="category-pagination__gap">&hellip;</span>
                        {% endif %}
                    {% endfor %}
                    {% if current_page < total_pages %}
                        <a class="btn btn-default" href="/categories/{{ category.slug }}/{{ current_page + 1 }}">{{ 'category.next'|trans }}</a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    </div>

    {% if category.elementsBelow is defined and category.elementsBelow %}
        {{ sitepack_elements(category.elementsBelow) }}
    {% endif %}

    {% app_block 'category_after' %}
{% endblock %}
